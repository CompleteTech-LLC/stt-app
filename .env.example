# Server-only OpenAI API key. Do not expose this value to browser code.
OPENAI_API_KEY=

# Optional shared HTTP Basic authentication. Set BOTH to enable; leave both blank
# to disable. Use HTTPS outside local development. Never use NEXT_PUBLIC_* names.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional model overrides. Defaults are chosen for speed/cost and low-latency live STT.
OPENAI_FILE_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_HIGH_ACCURACY_FILE_STT_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_STT_MODEL=gpt-realtime-whisper

# Optional operational tuning.
MAX_UPLOAD_BYTES=26214400
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
LOG_TRANSCRIPTS=false

# Set to true ONLY when the app sits behind a reverse proxy you control that sets
# X-Forwarded-For / X-Real-IP. Otherwise these headers are ignored (they can be forged)
# and all callers share a single rate-limit bucket.
TRUST_PROXY=false

# Optional secret salt for the hashed OpenAI-Safety-Identifier (authenticated user,
# or client address when TRUST_PROXY=true).
# If unset, a random per-process salt is used.
SAFETY_IDENTIFIER_SALT=
